{
	"name": "slack.ts",
	"version": "0.1.1",
	"type": "module",
	"files": [
		"src",
		"dist",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"format": "bun fmt",
		"build": "bun scripts/build.ts",
		"generate-elements-test": "bun scripts/generate-elements-test.ts > tests/elements.test.ts",
		"generate-events-test": "bun scripts/generate-events-test.ts > tests/events.test.ts",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@types/express": "^5.0.6",
		"node-mocks-http": "^1.18.1",
		"typescript": "^7"
	},
	"dependencies": {
		"@slack/types": "^3.2.0"
	}
}
